+#if defined(SDL_WINRT_HAVE_HDMI_DISPLAY_INFORMATION)
+// Local change (xemu on Xbox): move the console to the sharpest 60 Hz mode the TV in use offers, keeping its
+// colour settings. The console drops to 1080p by itself on a 1080p TV but does not go back up on a 4K one, and
+// a mode an app asks for lasts only while that app is on screen, so every start asks again.
+static void WINRT_RequestBestDisplayMode(void)
+{
+    using namespace Windows::Graphics::Display::Core;
+    try {
+        HdmiDisplayInformation ^ hdi = HdmiDisplayInformation::GetForCurrentView();
+        if (hdi == nullptr) {
+            return;
+        }
+        HdmiDisplayMode ^ cur = hdi->GetCurrentDisplayMode();
+        if (cur == nullptr) {
+            return;
+        }
+        const Uint64 curPixels = (Uint64)cur->ResolutionWidthInRawPixels * cur->ResolutionHeightInRawPixels;
+        // never past what this console draws for an app (Series S: 1440p): a 4K mode there left the picture
+        // in the bottom-left corner of a 4K screen (a player's Series S on a 4K TV)
+        Uint32 max_w = 0, max_h = 0;
+        WINRT_GetGamingDeviceMaxResolution(&max_w, &max_h);
+        HdmiDisplayMode ^ best = nullptr;
+        Uint64 bestScore = 0;
+        auto modes = hdi->GetSupportedDisplayModes();
+        for (unsigned int i = 0; i < modes->Size; ++i) {
+            HdmiDisplayMode ^ m = modes->GetAt(i);
+            if (m->StereoEnabled || m->RefreshRate < 59 || m->RefreshRate > 61) {
+                continue;
+            }
+            if (m->ResolutionWidthInRawPixels > max_w || m->ResolutionHeightInRawPixels > max_h) {
+                continue;
+            }
+            const Uint64 pixels = (Uint64)m->ResolutionWidthInRawPixels * m->ResolutionHeightInRawPixels;
+            if (pixels <= curPixels) {
+                continue;
+            }
+            const Uint64 score = pixels * 16 + (m->IsSmpte2084Supported == cur->IsSmpte2084Supported ? 8 : 0) +
+                                 (m->BitsPerPixel == cur->BitsPerPixel ? 4 : 0) + (m->ColorSpace == cur->ColorSpace ? 2 : 0) +
+                                 (m->PixelEncoding == cur->PixelEncoding ? 1 : 0);
+            if (score > bestScore) {
+                bestScore = score;
+                best = m;
+            }
+        }
+        if (best == nullptr) {
+            return;
+        }
+        auto op = hdi->RequestSetCurrentDisplayModeAsync(best);
+        CoreWindow ^ win = CoreWindow::GetForCurrentThread();
+        const Uint64 until = SDL_GetTicks() + 4000;
+        while (op->Status == Windows::Foundation::AsyncStatus::Started && SDL_GetTicks() < until) {
+            if (win != nullptr) {
+                win->Dispatcher->ProcessEvents(CoreProcessEventsOption::ProcessAllIfPresent);
+            }
+            SDL_Delay(10);
+        }
+        const bool done = (op->Status == Windows::Foundation::AsyncStatus::Completed) && op->GetResults();
+        SDL_Log("WinRT: display mode %ux%u -> %ux%u: %s", (unsigned)cur->ResolutionWidthInRawPixels,
+                (unsigned)cur->ResolutionHeightInRawPixels, (unsigned)best->ResolutionWidthInRawPixels,
+                (unsigned)best->ResolutionHeightInRawPixels, done ? "switched" : "not switched");
+    } catch (...) {
+    }
+}
+#endif
