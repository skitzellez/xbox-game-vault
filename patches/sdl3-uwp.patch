+// Local addition (xemu for Xbox Dev Mode): a file another app shared with SharedStorageAccessManager.AddFile
+// (Game Vault passes the token in its launch link) as a Win32 handle, for drives this app may not open itself.
+// Runs the WinRT calls on a thread of its own: blocking on them is not allowed on the app's UI thread.
+// Returns NULL when the token cannot be redeemed.
+extern "C" SDL_DECLSPEC void *SDLCALL SDL_WinRTOpenSharedFile(const char *token, bool writable)
+{
+    wchar_t *wtoken = WIN_UTF8ToStringW(token);
+    if (!wtoken) {
+        return NULL;
+    }
+    std::wstring t(wtoken);
+    SDL_free(wtoken);
+    HANDLE result = NULL;
+    std::thread worker([&]() {
+        if (FAILED(RoInitialize(RO_INIT_MULTITHREADED))) {
+            return;
+        }
+        try {
+            Windows::Storage::StorageFile ^ file =
+                create_task(Windows::ApplicationModel::DataTransfer::SharedStorageAccessManager::RedeemTokenForFileAsync(
+                    ref new Platform::String(t.c_str()))).get();
+            SDLUWP_IStorageItemHandleAccess *access = nullptr;
+            if (SUCCEEDED(reinterpret_cast<IUnknown *>(file)->QueryInterface(__uuidof(SDLUWP_IStorageItemHandleAccess),
+                                                                             (void **)&access))) {
+                HANDLE h = NULL;
+                if (SUCCEEDED(access->Create(writable ? (SDLUWP_HAO_READ | SDLUWP_HAO_WRITE) : SDLUWP_HAO_READ,
+                                             SDLUWP_HSO_SHARE_READ | SDLUWP_HSO_SHARE_WRITE, SDLUWP_HO_NONE,
+                                             nullptr, &h))) {
+                    result = h;
+                }
+                access->Release();
+            }
+        } catch (...) {
+        }
+        RoUninitialize();
+    });
+    worker.join();
+    return result;
+}
